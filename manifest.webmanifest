{
  "name": "نظام محمد صقر | الجيم",
  "short_name": "SAQR GYM",
  "id": "saqr-gym-app",
  "description": "تطبيق SAQR GYM لتتبع تمارين الجيم والتقدم في الأداء",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
  "orientation": "portrait",
  "background_color": "#0B0D0E",
  "theme_color": "#0B0D0E",
  "lang": "ar",
  "dir": "rtl",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
